SECRET_KEY=change-me-for-local-development
HOST=127.0.0.1
PORT=5001
DEBUG=false
CORS_ORIGINS=http://127.0.0.1:5001,http://localhost:5001
TRANSCRIPTION_MODE=auto
LOCAL_MODEL=small
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_TRANSCRIPTION_MODEL=
CLOUD_TIMEOUT_SECONDS=30
# Optional fast translation providers (keys stay in this backend .env)
TRANSLATION_GOOGLE_PROJECT_ID=
TRANSLATION_GOOGLE_API_KEY=
TRANSLATION_GOOGLE_LOCATION=global
TRANSLATION_MICROSOFT_ENDPOINT=https://api.cognitive.microsofttranslator.com
TRANSLATION_MICROSOFT_API_KEY=
TRANSLATION_MICROSOFT_REGION=
# Optional local precise translation (Ollama / LM Studio OpenAI-compatible API; API key is optional)
TRANSLATION_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
TRANSLATION_LOCAL_API_KEY=
TRANSLATION_LOCAL_MODEL=
# Optional precise model translation (OpenAI-compatible endpoint)
TRANSLATION_CLOUD_BASE_URL=
TRANSLATION_CLOUD_API_KEY=
TRANSLATION_CLOUD_MODEL=
TRANSLATION_TIMEOUT_SECONDS=20
AUDIO_MAX_QUEUE=64
# Window size for providers that infer once per window (cloud, Whisper).
AUDIO_WINDOW_SECONDS=3.0
AUDIO_OVERLAP_SECONDS=0.5
# How long to wait for the model to finish loading before reporting a timeout.
# The browser buffers audio for exactly this long.
AUDIO_STARTUP_TIMEOUT_SECONDS=45
# RMS below this is treated as room silence and handed to the model as digital
# silence, so the recording timeline stays exact. ~0.0005 is about -66 dBFS.
AUDIO_VAD_THRESHOLD=0.0005
# Optional course vocabulary used when the page does not send its own list.
AUDIO_GLOSSARY=

# --- Caption latency (Apple Silicon / MLX) -----------------------------------
# Streaming providers keep their own timeline, so this is only a delivery
# granularity: smaller chunks make the live caption scroll smoothly instead of
# jumping. Each inference step costs a fixed ~0.4s, so 1.0 is the practical
# floor (0.42x realtime); 0.5 would run at 0.82x with almost no headroom.
# Windowed providers (cloud, Whisper) ignore this and keep AUDIO_WINDOW_SECONDS.
STREAMING_CHUNK_SECONDS=1.0
# The Parakeet stream refuses to confirm the last `right context` encoder frames,
# and one frame is 0.08s. Confirmation lag = this value x 0.08s.
#   64 -> 5.12s lag (old hardcoded default)   32 -> 2.56s (default)
#   16 -> 1.28s                               8  -> 0.64s
# Lower is more responsive but leaves the model less right context to decode
# with, which costs accuracy on lecture vocabulary. Do not go below 8.
# Only used when MLX_LIVE_MODE=streaming.
MLX_STREAM_RIGHT_CONTEXT=32

# --- Live caption strategy (Apple Silicon) ----------------------------------
# windowed (default): re-decode the last MLX_WINDOW_SECONDS of audio with the
#   full-context path and publish only what falls past the first few seconds.
#   Readable on real accented lectures; latency = decode time + hop, not window.
# streaming: the incremental decoder. Faster to first caption on clean audio,
#   but it runs the encoder with local attention and produced unusable captions
#   on a real lecture recording.
MLX_LIVE_MODE=windowed
# Left context the decoder gets. Below ~12s the opening words lose their context
# and a quiet stretch can come back empty; 15-20s measured well.
MLX_WINDOW_SECONDS=18.0
# How often a new window is decoded. This is what the room feels as latency.
MLX_HOP_SECONDS=2.0
