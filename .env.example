SECRET_KEY=change-me-for-local-development
HOST=127.0.0.1
PORT=5001
DEBUG=false
CORS_ORIGINS=http://127.0.0.1:5001,http://localhost:5001
TRANSCRIPTION_MODE=auto
LOCAL_MODEL=small
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_TRANSCRIPTION_MODEL=
CLOUD_TIMEOUT_SECONDS=30
# Optional fast translation providers (keys stay in this backend .env)
TRANSLATION_GOOGLE_PROJECT_ID=
TRANSLATION_GOOGLE_API_KEY=
TRANSLATION_GOOGLE_LOCATION=global
TRANSLATION_MICROSOFT_ENDPOINT=https://api.cognitive.microsofttranslator.com
TRANSLATION_MICROSOFT_API_KEY=
TRANSLATION_MICROSOFT_REGION=
# Optional local precise translation (Ollama / LM Studio OpenAI-compatible API; API key is optional)
TRANSLATION_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
TRANSLATION_LOCAL_API_KEY=
TRANSLATION_LOCAL_MODEL=
# Optional precise model translation (OpenAI-compatible endpoint)
TRANSLATION_CLOUD_BASE_URL=
TRANSLATION_CLOUD_API_KEY=
TRANSLATION_CLOUD_MODEL=
TRANSLATION_TIMEOUT_SECONDS=20
AUDIO_MAX_QUEUE=32
AUDIO_WINDOW_SECONDS=3.0
AUDIO_OVERLAP_SECONDS=0.5
